# --- Database ---
DATABASE_URL="postgresql://claudetube:claudetube@localhost:5432/claudetube?schema=public"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-change-me-change-me-32"
AUTH_URL="http://localhost:3000"

# Optional: GitHub OAuth
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Object storage (S3-compatible; MinIO locally) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="claudetube"
S3_SECRET_KEY="claudetube"
S3_BUCKET="claudetube"
S3_FORCE_PATH_STYLE="true"

# --- Public origins ---
# The app origin (cookies, auth).
APP_ORIGIN="http://localhost:3000"
# The origin used to serve untrusted bundle HTML. MUST differ from APP_ORIGIN.
# In dev we fall back to a path prefix when this is empty.
BUNDLE_ORIGIN=""

# --- Limits ---
MAX_ZIP_BYTES="209715200"        # 200 MB compressed
MAX_EXTRACTED_BYTES="524288000"  # 500 MB uncompressed
MAX_ENTRIES="2000"
